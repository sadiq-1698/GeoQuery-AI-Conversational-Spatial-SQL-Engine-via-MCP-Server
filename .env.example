# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=changeme
# Only needed if 5432 is already taken on your machine (e.g. a local Postgres
# install) — uncomment and pick a free port, then update the two URLs below
# to match. docker-compose.yml defaults to 5432 if this isn't set.
# POSTGRES_HOST_PORT=5433
# Admin/write connection, used by db/migrate.sh and db/ingest/*.sh
DATABASE_URL=postgresql://geoquery_admin:changeme@localhost:5432/geoquery
# Read-only connection (geoquery_ro role), used ONLY by services/mcp-server
MCP_DATABASE_URL=postgresql://geoquery_ro:changeme_ro@localhost:5432/geoquery
MCP_RO_PASSWORD=changeme_ro

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- MCP transport (apps/web spawns services/mcp-server as a child process) ---
MCP_SERVER_CMD=node
MCP_SERVER_ARGS=../../services/mcp-server/dist/index.js

# --- Demo data scope ---
# Region label used to scope queries; set after running db/ingest for a city
DEFAULT_REGION=example-city
