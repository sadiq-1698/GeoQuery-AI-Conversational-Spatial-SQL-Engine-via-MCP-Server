# Example configuration for importing ONE demo city. Copy/adjust and source
# it, or just pass the values directly as flags to ingest.sh — this file only
# documents the shape of a real run, it isn't read automatically by anything.
#
# Where to get each input:
#   PBF        Geofabrik (https://download.geofabrik.de/) or BBBike
#              (https://extract.bbbike.org/) — pick a city/metro extract,
#              not a whole country, to keep the import fast.
#   TIGER_SHP  https://www2.census.gov/geo/tiger/TIGER2023/BG/ — download
#              tl_2023_<STATEFP>_bg.zip for your state and unzip it.
#   ACS_CSV    https://data.census.gov/ — export table B01003 (population),
#              B19013 (median income), B25001 (housing units) for your
#              county's block groups, then rename columns to match
#              census/join_acs.py's expected header (GEOID, population,
#              median_income, housing_units).

REGION=example-city
PBF=./data/example-city.osm.pbf
TIGER_SHP=./data/tl_2023_XX_bg.shp
ACS_CSV=./data/example-city-acs.csv

# Then run:
#   source db/ingest/config/example-city.env
#   pip install -r db/ingest/requirements.txt
#   ./db/ingest/ingest.sh --region "$REGION" --pbf "$PBF" \
#       --tiger-shp "$TIGER_SHP" --acs-csv "$ACS_CSV" --db-url "$DATABASE_URL"
